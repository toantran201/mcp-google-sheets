# ─── Auth: configure ONE of the two modes below ───────────────────────────

# Mode A (recommended) — Per-user OAuth
# Each user signs in with their own Google account in the browser on first use.
# Sheet edits are attributed to the real user in the sheet's version history.
GOOGLE_OAUTH_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-xxxxx"

# Mode B (legacy) — Google Service Account
# Headless; the target sheet must be shared with the service account email.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="my-agent@project-id.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...your-key...\n-----END PRIVATE KEY-----\n"

# NOTE: SPREADSHEET_ID has been removed — every tool now takes a required
# `spreadsheet` parameter (full Google Sheets URL or bare ID) per call.

# Optional — Restrict which tools are exposed to the Agent
# Leave blank to enable all. Comma-separated, no spaces.
# Available: get_spreadsheet_info,get_sheet_schema,create_sheet,rename_sheet,get_sheet_data,find_rows,add_rows,add_columns,update_row,delete_rows
TOOLS=""

# Optional — Appended to each row written by add_rows
USER_NAME=""
